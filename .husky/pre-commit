# Block direct commits to main
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo ""
  echo "BLOCKED: Direct commits to main are not allowed."
  echo "Create a feature branch first: git checkout -b feat/your-feature"
  echo ""
  echo "To bypass (emergency only): git commit --no-verify"
  echo ""
  exit 1
fi

# Block symlinks under docs/ or .claude/ — no cross-repo symlinks for documentation.
# Doctrine: all documentation lives in followup-rooms. Sister repos copy from us, not via symlink.
symlinks=$(find docs .claude -type l 2>/dev/null)
if [ -n "$symlinks" ]; then
  echo ""
  echo "BLOCKED: symlinks found under docs/ or .claude/."
  echo "All documentation must be inline files. No cross-repo symlinks."
  echo ""
  echo "Offending symlinks:"
  echo "$symlinks"
  echo ""
  echo "To bypass (emergency only): git commit --no-verify"
  echo ""
  exit 1
fi
